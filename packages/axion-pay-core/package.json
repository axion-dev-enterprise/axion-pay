{
  "name": "axion-pay-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test tests/*.test.mjs",
    "migrate": "tsx src/migrate.ts",
    "api-key:create": "tsx scripts/generate-api-key.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "fastify": "^5.5.0",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.7.0",
    "pg": "^8.16.3",
    "playwright": "^1.55.0",
    "stripe": "18.5.0",
    "undici": "^7.15.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
