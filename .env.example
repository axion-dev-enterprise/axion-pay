PORT=3333
NODE_ENV=development
DATABASE_URL=postgres://axion:axion@localhost:5432/axion_pay
REDIS_URL=redis://localhost:6379
# Altere para um valor forte fora do desenvolvimento. O Docker Compose usa este
# valor também para a conexão interna do PostgreSQL.
POSTGRES_PASSWORD=axion

# Chaves server-to-server. Formato:
# segredo-com-no-minimo-24-caracteres:merchantId:charges:write,charges:read
# Para múltiplas chaves, separe cada entrada com ';'. Nunca use esta chave no frontend.
AXION_API_KEYS=
RATE_LIMIT_PER_MINUTE=120
AUTH_API_BASE=https://auth.axionenterprise.cloud
DASHBOARD_ALLOWED_ORIGINS=https://pay.axionenterprise.cloud,https://flow.axionenterprise.cloud
KYC_REVIEWER_AUTH_USER_IDS=

# Provider principal de cobrança
PAYMENT_PROVIDER=woovi
PAYMENTS_ENABLED=false

# WOOVI / OPENPIX
# Produção Woovi: https://api.woovi.com
# Produção OpenPix: https://api.openpix.com.br
# Sandbox: https://api.woovi-sandbox.com
WOOVI_API_BASE=https://api.woovi-sandbox.com
WOOVI_APP_ID=
WOOVI_WEBHOOK_PUBLIC_KEYS_URL=https://api.woovi-sandbox.com/api/v1/webhook/public-keys

# Stripe — os segredos permanecem exclusivamente no Vault/runtime.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# AXION Flow
STRIPE_ENABLED=false
STRIPE_FLOW_PRICE_ID=
STRIPE_FLOW_SUCCESS_URL=https://flow.axionenterprise.cloud/dashboard?billing=success
STRIPE_FLOW_CANCEL_URL=https://flow.axionenterprise.cloud/dashboard?billing=cancelled
# Portal AXION Pay
STRIPE_BILLING_ENABLED=false
STRIPE_PRICE_ID=
PAY_APP_BASE_URL=https://pay.axionenterprise.cloud

# OPEN FINANCE
# IMPORTANTE: os endpoints dependem da instituição/parceiro Open Finance escolhido.
OPEN_FINANCE_ENABLED=false
OPEN_FINANCE_API_BASE=
OPEN_FINANCE_TOKEN_URL=
OPEN_FINANCE_CLIENT_ID=
OPEN_FINANCE_CLIENT_SECRET=
OPEN_FINANCE_MTLS_CERT_PATH=./certs/client.pem
OPEN_FINANCE_MTLS_KEY_PATH=./certs/client.key
OPEN_FINANCE_MTLS_CA_PATH=
OPEN_FINANCE_ACCOUNTS_PATH=
OPEN_FINANCE_TRANSACTIONS_PATH_TEMPLATE=

# NUBANK WEB PJ
NUBANK_WEB_ENABLED=false
NUBANK_WEB_URL=https://app.nubank.com.br/beta/pj/home
NUBANK_PROFILE_DIR=.nubank-profile
NUBANK_HEADLESS=false
ENABLE_BANK_RECONCILIATION=false
